# All environment variables for LINE Beacon Attendance (spec §50 + design doc §4, §8)
# Copy values into apps/api/.env (api) as needed. Never commit real secrets.

# --- Core ---
NODE_ENV=development
# API port. Design doc §4: api runs on 4000 (spec §50 example says 3000, but that
# collides with the web app).
PORT=4000

# --- Database (matches docker-compose.yml postgres service defaults) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/line_beacon_attendance?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=line_beacon_attendance

# --- Auth (Dashboard JWT) ---
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- LINE Messaging API (webhook + notifications) ---
# Must be a channel under the SAME LINE Provider as LINE_LOGIN_* (spec §50)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- LINE Login / LIFF ---
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LIFF_ID=

# --- URLs ---
# Public URL of the web app (use the cloudflared tunnel URL in dev, design doc §8)
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Used by apps/web to reach the api
API_BASE_URL=http://localhost:4000/api/v1
