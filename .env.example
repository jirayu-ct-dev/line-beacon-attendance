# All environment variables for LINE Beacon Attendance (spec §50 + design doc §4, §8)
# Dev:  copy to apps/api/.env (the API and jest read it from there).
# Prod: copy to .env at the repo root — `pnpm docker:prod` passes it to the
#       compose stack via env_file (secrets never enter the images).
# Never commit real secrets.

# --- Core ---
NODE_ENV=development
# API port. Design doc §4: api runs on 4000 (spec §50 example says 3000, but that
# collides with the web app).
PORT=4000

# --- Database (matches docker-compose.yml postgres service defaults) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/line_beacon_attendance?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=line_beacon_attendance

# --- Auth (Dashboard JWT) ---
# Required. Random string >= 16 chars (e.g. `openssl rand -hex 32`). The app
# refuses to start without it. Refresh tokens are opaque random values (not
# JWTs, design doc §5.2), so no JWT_REFRESH_SECRET is needed.
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d
# Set true when the API is served over HTTPS (adds the Secure flag to cookies)
COOKIE_SECURE=false

# --- Seed admin user (apps/api/prisma/seed.ts via `pnpm seed:api`) ---
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin

# --- Rate limiting (@nestjs/throttler global default; login is stricter at 10/min) ---
THROTTLER_TTL_MS=60000
THROTTLER_LIMIT=100

# --- Prisma migrations (optional; only needed by `prisma migrate dev`/`migrate diff`) ---
# A throwaway database on the same postgres instance, e.g.
# SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/line_beacon_shadow

# --- LINE Messaging API (webhook + notifications) ---
# Must be a channel under the SAME LINE Provider as LINE_LOGIN_* (spec §50)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- LINE notifications (spec §42 cooldown) ---
# Suppress duplicate user-facing messages (NO_ACTIVE_ACTIVITY / UNKNOWN_USER /
# OUTSIDE_CHECKIN_WINDOW) for the same student+type within this window.
# The spec gives no exact number; the implementation default is 10 minutes.
NOTIFICATION_COOLDOWN_MINUTES=10

# --- LINE Login / LIFF ---
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# LIFF app id of the LINE Login channel (spec §50)
LIFF_ID=
# Same LIFF id, Nuxt runtime-config form for apps/web (NUXT_PUBLIC_* maps to
# runtimeConfig.public.liffId). Leave empty until a LIFF app + tunnel exist.
NUXT_PUBLIC_LIFF_ID=

# --- URLs ---
# Public URL of the web app (use the cloudflared tunnel URL in dev, design doc §8)
APP_URL=http://localhost:3000
# Also the CORS origin the API echoes (spec §30.12)
FRONTEND_URL=http://localhost:3000
# Used by apps/web to reach the api. In prod Docker this is the Nitro /api
# proxy target, resolved at BUILD time (compose passes http://api:4000).
API_BASE_URL=http://localhost:4000/api/v1
