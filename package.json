{
  "name": "line-beacon-attendance",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web run dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:api": "pnpm --filter api test",
    "test:web": "pnpm --filter web test",
    "seed:api": "pnpm --filter api db:seed",
    "gen:api": "pnpm --filter api gen:openapi && pnpm --filter web gen:types",
    "docker:up": "docker compose up -d postgres",
    "docker:prod": "docker compose --env-file .env -f docker/compose.prod.yml up -d --build",
    "dev:tunnel": "cloudflared tunnel --url http://localhost:3000"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
